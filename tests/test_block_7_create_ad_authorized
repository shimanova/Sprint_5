import time
from selenium.webdriver.support import expected_conditions as EC
from selenium.webdriver.common.by import By
from locators.locators import AuthLocators, AdLocators

class TestBlock8CreateAdAuthorized:
    
    def test_create_ad_authorized(self, driver):
        # 1. Авторизация
        driver.wait.until(EC.element_to_be_clickable(AuthLocators.LOGIN_REG_BUTTON)).click()
        driver.find_element(*AuthLocators.EMAIL_FIELD).send_keys("1shimanova_32@gmail.com")
        driver.find_element(*AuthLocators.PASSWORD_FIELD).send_keys("000000")
        driver.wait.until(EC.element_to_be_clickable(AuthLocators.LOGIN_BUTTON)).click()
        driver.wait.until(EC.visibility_of_element_located(AuthLocators.USER_AVATAR))
        
        # 2. Открыть форму создания объявления
        driver.wait.until(EC.element_to_be_clickable(AdLocators.ADD_AD_BUTTON)).click()
        time.sleep(1)
        
        # 3. Заполнить поля
        title = f"Ноутбук {int(time.time() * 1000)}"
        
        name_field = driver.find_element(*AdLocators.TITLE_FIELD)
        driver.execute_script("arguments[0].scrollIntoView(true);", name_field)
        name_field.click()
        name_field.send_keys(title)
        
        desc_field = driver.find_element(*AdLocators.DESCRIPTION_FIELD)
        driver.execute_script("arguments[0].scrollIntoView(true);", desc_field)
        desc_field.click()
        desc_field.send_keys("Отличное состояние")
        
        price_field = driver.find_element(*AdLocators.PRICE_FIELD)
        driver.execute_script("arguments[0].scrollIntoView(true);", price_field)
        price_field.click()
        price_field.send_keys("25000")
        
        # 4. Выбрать состояние
        new_label = driver.find_element(*AdLocators.CONDITION_NEW)
        driver.execute_script("arguments[0].scrollIntoView(true);", new_label)
        new_label.click()
        
        # 5. Опубликовать
        publish_btn = driver.find_element(*AdLocators.PUBLISH_BUTTON)
        driver.execute_script("arguments[0].scrollIntoView(true);", publish_btn)
        publish_btn.click()
        time.sleep(3)
        
        # 6. Перейти в профиль
        driver.get("https://qa-desk.education-services.ru/profile")
        time.sleep(2)
        
        # 7. Искать объявление с перелистыванием страниц
        found = False
        max_pages = 10
        
        for page in range(max_pages):
            # Поиск объявления на текущей странице
            try:
                element = driver.find_element(By.XPATH, f"//h2[contains(text(), '{title}')]")
                if element.is_displayed():
                    found = True
                    break
            except:
                pass
            
            # Если не нашли и это не последняя страница, листаем дальше
            if page < max_pages - 1:
                try:
                    next_arrow = driver.find_element(*AdLocators.NEXT_ARROW)
                    if next_arrow.is_enabled():
                        driver.execute_script("arguments[0].scrollIntoView(true);", next_arrow)
                        time.sleep(0.5)
                        next_arrow.click()
                        time.sleep(2)
                    else:
                        break
                except:
                    break
        
        assert found, f"Объявление '{title}' не найдено в профиле после перелистывания {max_pages} страниц"